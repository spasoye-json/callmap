{
  "name": "archmap",
  "version": "0.0.0",
  "private": true,
  "description": "Archmap keeps a true map of a software system, business logic first.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/app",
    "lint": "npm run format:check && npm run typecheck && eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@archmap/app": "*",
    "@archmap/canvas-model": "*",
    "@archmap/cost": "*",
    "@archmap/discovery": "*",
    "@archmap/extractor-go": "*",
    "@archmap/extractor-ruby": "*",
    "@archmap/extractor-typescript": "*",
    "@archmap/flow-document": "*",
    "@archmap/flow-library": "*",
    "@archmap/layout": "*",
    "@archmap/reference-graph": "*",
    "@archmap/scope": "*",
    "@archmap/sidecar": "*",
    "@archmap/staleness": "*",
    "@archmap/testing": "*",
    "@archmap/trace": "*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
