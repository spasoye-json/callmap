{
  "name": "archmap",
  "version": "0.0.0",
  "private": true,
  "description": "Archmap will read the call graph of a repo with its language's own tools and write one HTML page for a code review.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/cli/page",
    "lint": "npm run format:check && npm run typecheck && eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
