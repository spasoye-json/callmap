diff --git a/packages/extractor-go/go/probe.go b/packages/extractor-go/go/probe.go
new file mode 100644
--- /dev/null
+++ b/packages/extractor-go/go/probe.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"fmt"
+	"go/ast"
+	"go/types"
+	"os"
+	"strings"
+)
+
+var probedInterfaces = map[*ast.CallExpr]string{}
+
+func probeExpression(site callSite) string {
+	return strings.Join(strings.Fields(sourceTextOf(site, site.call.Fun)), "")
+}
+
+func probeValueKind(site callSite) string {
+	info := site.file.pkg.TypesInfo
+	switch fun := ast.Unparen(site.call.Fun).(type) {
+	case *ast.CallExpr:
+		return "the result of a call"
+	case *ast.SelectorExpr:
+		if variable, isVar := info.Uses[fun.Sel].(*types.Var); isVar && variable.IsField() {
+			return "a struct field"
+		}
+		return "a package variable"
+	case *ast.Ident:
+		variable, isVar := info.Uses[fun].(*types.Var)
+		switch {
+		case !isVar:
+			return "another expression"
+		case variable.Parent() == variable.Pkg().Scope():
+			return "a package variable"
+		case variable.Kind() == types.ParamVar || variable.Kind() == types.RecvVar || variable.Kind() == types.ResultVar:
+			return "a parameter"
+		}
+		return "a local variable"
+	}
+	return "another expression"
+}
+
+func probeOtherKind(site callSite) string {
+	info := site.file.pkg.TypesInfo
+	fun := ast.Unparen(site.call.Fun)
+	if _, isStar := fun.(*ast.StarExpr); isStar {
+		return "a dereferenced pointer"
+	}
+	if index, isIndex := fun.(*ast.IndexExpr); isIndex {
+		if indexed := info.TypeOf(index.X); indexed != nil {
+			if _, isMap := indexed.Underlying().(*types.Map); isMap {
+				return "a map value with a constant key"
+			}
+		}
+		return "a slice element"
+	}
+	if _, isParameter := types.Unalias(info.TypeOf(fun)).(*types.TypeParam); isParameter {
+		return "a type parameter"
+	}
+	return "another expression"
+}
+
+func probeDetailOf(site callSite, reason openEndReason) string {
+	switch reason {
+	case functionValue:
+		return probeValueKind(site)
+	case noImplementation:
+		return probedInterfaces[site.call]
+	case otherReason:
+		return probeOtherKind(site)
+	case dynamicKey:
+		return "a map value with a key that is not a constant"
+	}
+	return string(reason)
+}
+
+func probeOpenEnd(site callSite, reason openEndReason) {
+	fmt.Fprintf(os.Stderr, "OPEN\t%s\t%s\t%s\t%s:%d\n", reason, probeDetailOf(site, reason), probeExpression(site), site.file.path, lineOf(site))
+}
+
+func probeInterface(decision string, called types.Type, site callSite) {
+	name := types.TypeString(called, func(pkg *types.Package) string { return pkg.Name() })
+	probedInterfaces[site.call] = name
+	fmt.Fprintf(os.Stderr, "IFACE\t%s\t%s\t%s\t%s:%d\n", decision, name, probeExpression(site), site.file.path, lineOf(site))
+}
